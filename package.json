{
  "name": "ask-user-question",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT plugin that asks structured clarification questions with an MCP Apps UI.",
  "scripts": {
    "build": "npm run build:ui && tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "dev": "tsx watch server/index.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "validate:package": "node scripts/validate-package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run validate:package"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/apps-sdk-ui": "0.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
