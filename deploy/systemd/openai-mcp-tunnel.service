[Unit]
Description=OpenAI Secure MCP Tunnel for Ask User Question
Documentation=https://developers.openai.com/api/docs/guides/secure-mcp-tunnels
Requires=ask-user-question-mcp.service
After=ask-user-question-mcp.service network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/ask-user-question/control-plane-api-key

[Service]
Type=simple
EnvironmentFile=%h/.config/ask-user-question/tunnel.env
LoadCredential=control-plane-api-key:%h/.config/ask-user-question/control-plane-api-key
ExecStartPre=/usr/bin/curl --fail --silent --show-error --retry 15 --retry-connrefused --retry-delay 1 http://127.0.0.1:8787/
ExecStart=/usr/local/bin/tunnel-client run --control-plane.api-key file:%d/control-plane-api-key
Restart=always
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
